{
    "name": "support-ticket-api",
    "version": "1.0.0",
    "description": "",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "build": "tsc --noEmit && tsc && tsc-alias --resolve-full-paths --resolve-full-extension .js",
        "exec": "tsc-watch --noClear --noEmit --onSuccess \"tsx src/index.ts\"",
        "check": "tsc --noEmit",
        "start": "tsc --noEmit && node dist/index.js",
        "lint": "eslint .",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "migration:show": "npm run build && typeorm migration:show -d dist/database/data-source.js",
        "migration:run": "npm run build && typeorm migration:run -d dist/database/data-source.js",
        "migration:revert": "npm run build && typeorm migration:revert -d dist/database/data-source.js",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/express": "^5.0.6",
        "@types/node": "^22.20.5",
        "@types/pg": "^8.23.1",
        "@types/supertest": "^7.2.1",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.14.0",
        "prettier": "^3.10.1",
        "supertest": "^7.3.2",
        "tsc-alias": "^1.9.10",
        "tsc-watch": "^7.2.1",
        "tsx": "^4.23.15",
        "typescript": "6.0.3",
        "typescript-eslint": "8.72.2",
        "vitest": "^5.1.1"
    },
    "dependencies": {
        "dotenv": "^18.0.10",
        "express": "^5.3.0",
        "pg": "^8.23.1",
        "reflect-metadata": "^0.2.2",
        "typeorm": "^1.1.3"
    }
}
